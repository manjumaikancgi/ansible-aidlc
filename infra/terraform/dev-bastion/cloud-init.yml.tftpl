#cloud-config
package_update: true
package_upgrade: false
packages:
  - apt-transport-https
  - ca-certificates
  - curl
  - git
  - gnupg
  - jq
  - lsb-release
  - python3
  - python3-apt
  - python3-pip
  - python3-venv
  - rsync
  - software-properties-common
  - unzip

runcmd:
%{ if install_ansible ~}
  - add-apt-repository --yes universe
  - apt-get update -y
  - DEBIAN_FRONTEND=noninteractive apt-get install -y ansible
%{ endif ~}
  - install -d -o ${admin_username} -g ${admin_username} /home/${admin_username}/gs-pov-harness-agent
  - install -d -o ${admin_username} -g ${admin_username} /home/${admin_username}/ansible-aidlc
  - echo "Good Shepherd dev deployment bastion ready" > /etc/motd
